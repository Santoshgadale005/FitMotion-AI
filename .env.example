# FitMotion AI Environment Configuration
# Copy this file to `.env` and adjust values as needed.

APP_ENV=development
DATABASE_URL=sqlite:///data/fitmotion.db

# Optional LLM Configuration (Phase 7 - AI Training Assistant)
# The assistant includes a full offline fallback when no API key is provided.
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
